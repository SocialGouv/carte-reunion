# Copier en .env pour le développement local (npm run dev lit .env).
PORT=3000

# Brique LiteLLM, avec /v1. Utiliser une clé de service dédiée, pas une clé personnelle.
LITELLM_BASE_URL=https://LITELLM-DNUM/v1
LITELLM_API_KEY=sk-...

STT_MODEL=scaleway/whisper-large-v3
LLM_MODEL=scaleway/gpt-oss-120b

CHUNK_SECONDS=25
MAP_INTERVAL_SECONDS=30
MAP_MIN_NEW_WORDS=150
MAP_INTERVAL_MIN_WORDS=20
SESSION_TTL_HOURS=24
DATA_DIR=./data

# Si renseigné, exigé pour créer une séance (recommandé dès que l'URL est publique).
CREATE_TOKEN=

# Active POST /api/sessions/:id/transcript (texte sans audio) pour npm run replay. Jamais en production.
DEV_TEXT_INPUT=true
